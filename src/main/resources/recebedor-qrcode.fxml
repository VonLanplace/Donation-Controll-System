<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      alignment="TOP_CENTER"
      prefHeight="640.0"
      prefWidth="560.0"
      spacing="16.0"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.vonlanplace.doacao.javafx.controller.RecebedorQrCodeController">

    <padding>
        <Insets bottom="24.0" left="32.0" right="32.0" top="24.0"/>
    </padding>

    <Label text="Cadastro de Recebedor"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>

    <Label maxWidth="460.0"
           text="Escaneie o QR code com a câmera do celular para abrir o formulário web. O celular precisa estar na mesma rede do computador."
           wrapText="true"
           style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>

    <StackPane style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-width: 1; -fx-padding: 12;">
        <ImageView fx:id="qrCodeImage"
                   fitHeight="360.0"
                   fitWidth="360.0"
                   preserveRatio="true"/>
    </StackPane>

    <Hyperlink fx:id="linkCadastro"
               maxWidth="460.0"
               onAction="#abrirNoNavegador"
               style="-fx-font-size: 12px;"/>

    <Label fx:id="statusLabel"
           maxWidth="460.0"
           text="Carregando QR code..."
           wrapText="true"
           style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>

    <HBox alignment="CENTER" spacing="12.0">
        <Button defaultButton="true"
                onAction="#abrirNoNavegador"
                text="Abrir no navegador"/>
        <Button onAction="#atualizarQrCode"
                text="Atualizar QR code"/>
    </HBox>

</VBox>
