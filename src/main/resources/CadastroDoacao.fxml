<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" alignment="TOP_CENTER" hgap="15.0" vgap="15.0" prefWidth="800.0"
          prefHeight="600.0" xmlns="http://javafx.com/javafx/17"
          fx:controller="com.vonlanplace.doacao.controller.CadastroDoacaoController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>

    <children>
        <!-- Título Principal -->
        <Label text="Nova Doação" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

        <!-- Área de Doação (Informações do Doador) -->
        <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <children>
                <Label text="Informações do Doador"/>
                <HBox spacing="15.0">
                    <children>
                        <!-- Campo Nome -->
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Nome Doador"/>
                                <TextField fx:id="txtNome" promptText="Digite o nome completo"/>
                            </children>
                        </VBox>
                        <!-- Campo Data -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Data"/>
                                <DatePicker fx:id="dtpDataDoacao"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Área de Produtos (Tabela e Ações dos Itens) -->
        <VBox spacing="10.0" VBox.vgrow="ALWAYS" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="Itens da Doação"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="8.0">
                            <children>
                                <Button fx:id="btnRemover" text="Remover" onAction="#handleRemoverProduto"/>
                                <Button fx:id="btnAdicionar" text="Adicionar Produto"
                                        onAction="#handleAdicionarProduto"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="tabelaProdutos">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Nenhum produto na lista."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Codigo de Barras" minWidth="140.0" prefWidth="160.0"
                                     maxWidth="200.0"/>
                        <TableColumn fx:id="colTipo" text="Tipo"/>
                        <TableColumn fx:id="colMarca" text="Marca"/>
                        <TableColumn fx:id="colValidade" text="Validade"/>
                    </columns>
                </TableView>
            </children>
        </VBox>

        <!-- Área de Botões Base (Ações do Formulário) -->
        <HBox alignment="CENTER_RIGHT" spacing="15.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <padding>
                <Insets top="10.0"/>
            </padding>
            <children>
                <Button fx:id="btnDeletar" text="Deletar" onAction="#handleDeletar" prefWidth="120.0"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" prefWidth="120.0"/>
                <Button fx:id="btnAcaoPrincipal" text="Finalizar Cadastro" onAction="#handleFinalizarCadastro"
                        prefWidth="160.0"/>
            </children>
        </HBox>
    </children>
</GridPane>